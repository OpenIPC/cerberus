#!/bin/sh
# OpenIPC uses BusyBox init, not systemd. Config lives in the U-Boot environment, which is also
# where cerberus keeps the join material it gets back from the coordinator, so a camera is
# provisioned with `fw_setenv` and a restart, without touching the read-only rootfs.

DAEMON=/usr/sbin/cerberus
PIDFILE=/var/run/cerberus.pid

# cerberus_<name>, or streq_<name> — what the keys were called before the agent was renamed. A
# missing key is harmless: an empty variable means "the default" to the agent.
uenv() {
	fw_printenv -n "cerberus_$1" 2>/dev/null || fw_printenv -n "streq_$1" 2>/dev/null
}

export CERBERUS_API="$(uenv api)"
export CERBERUS_ENROLLMENT_TOKEN="$(uenv enrollment_token)"
export CERBERUS_HOSTNAME="$(uenv hostname)"
# A firmware may carry no CA bundle at all; then enrolment fails on the coordinator's certificate
# and nothing short of a reflash fixes it. Point cerberus_ca at the root certificate instead.
export CERBERUS_CA="$(uenv ca)"
export CERBERUS_KIND="$(uenv kind)"
export CERBERUS_SUBNET="$(uenv subnet)"
export CERBERUS_HEARTBEAT="$(uenv heartbeat)"
export CERBERUS_PING_TARGET="$(uenv ping_target)"
export CERBERUS_PING_INTERVAL="$(uenv ping_interval)"
export CERBERUS_PING_TIMEOUT="$(uenv ping_timeout)"
export CERBERUS_PING_FAILS="$(uenv ping_fails)"
CERBERUS_IFACE=$(uenv iface)
export CERBERUS_IFACE=${CERBERUS_IFACE:-wg0}

case "$1" in
	start)
		[ -n "$CERBERUS_API" ] || { echo "cerberus: not provisioned (fw_setenv cerberus_api ...)"; exit 0; }
		echo "Starting cerberus..."
		start-stop-daemon -S -q -m -b -p $PIDFILE -x $DAEMON -- run
		;;
	stop)
		echo "Stopping cerberus..."
		start-stop-daemon -K -q -p $PIDFILE
		# The agent may never have got as far as the interface; for init, stopping a service that
		# is not up is still a success.
		ip link del dev "$CERBERUS_IFACE" 2>/dev/null || true
		;;
	restart|reload)
		"$0" stop
		sleep 1
		"$0" start
		;;
	status)
		$DAEMON status
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
